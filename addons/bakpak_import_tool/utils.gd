@tool
class_name BakPakUtils
extends Object

const METADATA_GENERATED = "bakpak_generated"

# Directory listings used by canonicalize_path(), valid for one import run.
static var _dir_listing_cache: Dictionary = {}


## Saves `resource` to `path`, then refreshes the instance the engine already has in
## memory for that path, and returns that instance (or null on failure).
##
## Scenes that are open in the editor hold a reference to the cached resource
## object, not to the file. Putting a different object at the same path (which is
## what Resource.take_over_path() does) leaves every open scene on the old, now
## path-less, object. Loading with CACHE_MODE_REPLACE instead refreshes the existing
## object from the file that was just written, so every user of the resource sees
## the new data immediately. The file keeps its UID: ResourceSaver derives it from
## the path, not from the saved object.
static func save_resource_in_place(resource: Resource, path: String) -> Resource:
	var err := ResourceSaver.save(resource, path)
	if err != OK:
		printerr("[BakPakImportTool] Failed to save resource: ", path, " Error: ", err)
		return null
	# (In the editor, ResourceSaver already reports the saved file to EditorFileSystem.)

	var live: Resource = ResourceLoader.load(path, "", ResourceLoader.CACHE_MODE_REPLACE)
	if not live:
		printerr("[BakPakImportTool] Failed to reload saved resource: ", path)
		return null

	# Refreshing a mesh in place does not notify its users by itself. MeshInstance3D
	# relies on this signal to resize its surface overrides and update its gizmos.
	live.emit_changed()
	live.notify_property_list_changed()
	return live


## Returns `path` spelled the way it exists on disk.
##
## The resource cache and scene_file_path comparisons are case-sensitive, but
## Windows and macOS file systems are not: "res://assets/tree.res" opens the file
## stored as "res://Assets/tree.res" while being a different resource cache entry.
## Every path the tool builds goes through here so it always addresses the same
## cache entry as the rest of the editor. Parts that do not exist yet are kept as
## requested.
static func canonicalize_path(path: String) -> String:
	if not path.begins_with("res://"):
		return path

	var segments := path.trim_prefix("res://").split("/", false)
	var current := "res://"
	for i in segments.size():
		var entries: PackedStringArray = _list_dir(current)
		var actual := segments[i]
		if not entries.has(actual):
			var lower := actual.to_lower()
			var found := false
			for entry in entries:
				if entry.to_lower() == lower:
					actual = entry
					found = true
					break
			if not found:
				return current.path_join("/".join(segments.slice(i)))
		current = current.path_join(actual)
	return current


static func clear_path_cache() -> void:
	_dir_listing_cache.clear()


static func _list_dir(dir_path: String) -> PackedStringArray:
	if not _dir_listing_cache.has(dir_path):
		var entries := DirAccess.get_directories_at(dir_path)
		entries.append_array(DirAccess.get_files_at(dir_path))
		_dir_listing_cache[dir_path] = entries
	return _dir_listing_cache[dir_path]


## Reads a metadata value stored on the root node of a scene without instantiating it.
static func get_scene_root_meta(scene: PackedScene, key: String, default: Variant = null) -> Variant:
	if not scene:
		return default
	var state := scene.get_state()
	if state.get_node_count() == 0:
		return default
	var property_name := "metadata/" + key
	for i in state.get_node_property_count(0):
		if state.get_node_property_name(0, i) == property_name:
			return state.get_node_property_value(0, i)
	return default


## Whether the scene at `path` was generated by this tool.
## The file text is checked first so unrelated scenes are never loaded.
static func is_generated_scene(path: String) -> bool:
	if not path.ends_with(".tscn") or not FileAccess.file_exists(path):
		return false
	if not FileAccess.get_file_as_string(path).contains("metadata/" + METADATA_GENERATED):
		return false
	var scene := ResourceLoader.load(path, "PackedScene") as PackedScene
	return get_scene_root_meta(scene, METADATA_GENERATED, false) == true


static func generate_mesh_lods(mesh: ArrayMesh, lod_group_name: String = "") -> Dictionary:
	if lod_group_name == "":
		lod_group_name = ProjectSettings.get_setting("BakPak/ImportTool/default_lod_group", "default")

	var groups = ProjectSettings.get_setting("BakPak/ImportTool/lod_groups", {})
	var default_name = ProjectSettings.get_setting("BakPak/ImportTool/default_lod_group", "default")
	var group_params = groups.get(lod_group_name, groups.get(default_name, {
		"normal_merge_angle": 25.0,
		"normal_split_angle": 60.0,
		"bias": 1.0
	}))

	var merge_angle = group_params.get("normal_merge_angle", 25.0)
	var split_angle = group_params.get("normal_split_angle", 60.0)

	var importer = ImporterMesh.new()
	for i in range(mesh.get_surface_count()):
		var arrays = mesh.surface_get_arrays(i)
		var name = mesh.surface_get_name(i)
		var mat = mesh.surface_get_material(i)
		var format = mesh.surface_get_format(i)

		var empty_blend_shapes: Array[Array] = []
		importer.add_surface(mesh.surface_get_primitive_type(i), arrays, empty_blend_shapes, {}, mat, name, format)

	var all_bone_transforms: Array[Transform3D] = []
	var global_max_bone_idx = -1
	for i in range(mesh.get_surface_count()):
		var format = mesh.surface_get_format(i)
		if format & Mesh.ARRAY_FORMAT_BONES:
			var arrays = mesh.surface_get_arrays(i)
			var bones = arrays[Mesh.ARRAY_BONES]
			if bones:
				for b in bones:
					if b > global_max_bone_idx:
						global_max_bone_idx = b

	if global_max_bone_idx >= 0:
		for b in range(global_max_bone_idx + 1):
			all_bone_transforms.append(Transform3D.IDENTITY)

	importer.generate_lods(merge_angle, split_angle, all_bone_transforms)

	# Collect LOD info
	var surfaces_lod_info = []
	var surface_count = importer.get_surface_count()
	for i in range(surface_count):
		var lod_count = importer.get_surface_lod_count(i)
		var base_indices = importer.get_surface_arrays(i)[Mesh.ARRAY_INDEX]
		var base_triangles = 0
		if base_indices:
			base_triangles = base_indices.size() / 3
		else:
			var verts = importer.get_surface_arrays(i)[Mesh.ARRAY_VERTEX]
			base_triangles = verts.size() / 3

		var lod_triangles_list = [base_triangles]

		for lod_idx in range(lod_count):
			var lod_indices = importer.get_surface_lod_indices(i, lod_idx)
			var lod_triangles = lod_indices.size() / 3
			lod_triangles_list.append(lod_triangles)

		surfaces_lod_info.append(lod_triangles_list)

	var new_mesh = importer.get_mesh()
	return {
		"mesh": new_mesh,
		"lod_info": surfaces_lod_info
	}
