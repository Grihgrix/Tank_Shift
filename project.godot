config_version=5

[BakPak]

ImportTool/preset_import_materials={
"tree_leaves": "uid://bvbe8rcfyk74b",
"tree_trunk": "uid://dm1cskx60sodj"
}
ImportTool/auto_generate_lods=false

[application]

config/name="TankShift"
run/main_scene="uid://5re30mheve6q"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Global="*uid://da1itjvbca8ia"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/bakpak_import_tool/plugin.cfg", "res://addons/brackeys_particle_controls/plugin.cfg", "res://addons/imjp94.yafsm/plugin.cfg")

